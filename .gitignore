cat << 'EOF' > .gitignore
# ===== Logs =====
slurm-*.out

# ===== Shell scripts (exclude) =====
*.sh

# ===== Python =====
__pycache__/
*.pyc
*.pyo

# ===== Environments / cache =====
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.cache/

# ===== Data & models =====
*.pt
*.model
*.ckpt
*.pth
*.npz

# ===== macOS garbage =====
.DS_Store
__MACOSX/
._*

# ===== HuggingFace / Hydra =====
.hydra/
checkpoints/

# ===== Misc =====
None
EOF

# ルート直下の data
/data/

# src/tr_asbs 配下の data だけ
!/src/tr_asbs/data/